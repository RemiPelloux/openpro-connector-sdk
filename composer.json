{
    "name": "openpro/connector-sdk",
    "description": "Official OpenPro SDK to sync ATS jobs into OpenPro from PHP or any language via REST.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/RemiPelloux/openpro-connector-sdk",
    "support": {
        "issues": "https://github.com/RemiPelloux/openpro-connector-sdk/issues",
        "source": "https://github.com/RemiPelloux/openpro-connector-sdk",
        "docs": "https://github.com/RemiPelloux/openpro-connector-sdk#readme"
    },
    "keywords": [
        "openpro",
        "ats",
        "jobs",
        "mcp",
        "connector"
    ],
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/log": "^3.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "OpenPro\\ConnectorSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenPro\\ConnectorSdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
