#!/usr/bin/env sh
# ------------------------------------------------------------------
# pre-commit — openprosdk (PHP connector library)
#
# Runs php -l on staged PHP files, then phpunit when PHP changed.
# ------------------------------------------------------------------
ROOT="$(git rev-parse --show-toplevel)"
# Staged-file quality hooks from .pre-commit-config.yaml (hygiene, gitleaks, shellcheck, linters).
if [ -f "$ROOT/.pre-commit-config.yaml" ]; then
  if command -v pre-commit >/dev/null 2>&1; then
    (cd "$ROOT" && pre-commit run --hook-stage pre-commit) || exit 1
  else
    echo "⚠ pre-commit not installed; skipping .pre-commit-config.yaml hooks (uv tool install pre-commit)" >&2
  fi
fi

STAGED=$(mktemp)
trap 'rm -f "$STAGED"' EXIT HUP INT TERM
git diff --cached --name-only --diff-filter=ACMR -z -- '*.php' > "$STAGED"

if [ ! -s "$STAGED" ]; then
  echo "✅ Pre-commit: no PHP files staged — skipping."
  exit 0
fi

if ! xargs -0 sh -c '
  root=$1
  shift
  for file do
    php -l "$root/$file" || exit 1
  done
' sh "$ROOT" < "$STAGED"; then
  echo "❌ Pre-commit: PHP syntax check failed."
  exit 1
fi

cd "$ROOT" && vendor/bin/phpunit || exit 1

echo "✅ Pre-commit checks passed."
