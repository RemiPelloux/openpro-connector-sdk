#!/usr/bin/env sh
# ------------------------------------------------------------------
# pre-commit — openprosdk (optimized)
#
# Runs quality gate + TypeScript check in parallel.
# ------------------------------------------------------------------
ROOT="$(git rev-parse --show-toplevel)"

# Fast skip: if no TS/TSX/Py files staged, nothing to check
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.py' 2>/dev/null || true)
if [ -z "$STAGED" ]; then
  echo "✅ Pre-commit: no TS/TSX/Py files staged — skipping."
  exit 0
fi

FAIL=0

bash "$ROOT/scripts/check-quality.sh" &
PID_QUALITY=$!

cd "$ROOT" && pnpm exec tsc --noEmit &
PID_TSC=$!

wait $PID_QUALITY || FAIL=1
wait $PID_TSC     || FAIL=1

[ "$FAIL" -ne 0 ] && exit 1
echo "✅ Pre-commit checks passed."
