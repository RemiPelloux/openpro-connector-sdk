#!/usr/bin/env sh
# ------------------------------------------------------------------
# pre-commit — openprosdk (PHP connector library)
#
# Runs php -l on staged PHP files, then phpunit when PHP changed.
# ------------------------------------------------------------------
ROOT="$(git rev-parse --show-toplevel)"

STAGED=$(mktemp)
trap 'rm -f "$STAGED"' EXIT HUP INT TERM
git diff --cached --name-only --diff-filter=ACMR -z -- '*.php' > "$STAGED"

if [ ! -s "$STAGED" ]; then
  echo "✅ Pre-commit: no PHP files staged — skipping."
  exit 0
fi

if ! xargs -0 sh -c '
  root=$1
  shift
  for file do
    php -l "$root/$file" || exit 1
  done
' sh "$ROOT" < "$STAGED"; then
  echo "❌ Pre-commit: PHP syntax check failed."
  exit 1
fi

cd "$ROOT" && vendor/bin/phpunit || exit 1

echo "✅ Pre-commit checks passed."
