#!/usr/bin/env sh
# ------------------------------------------------------------------
# pre-commit — openprosdk (PHP connector library)
#
# Runs php -l on staged PHP files, then phpunit when PHP changed.
# ------------------------------------------------------------------
ROOT="$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php' 2>/dev/null || true)
if [ -z "$STAGED" ]; then
  echo "✅ Pre-commit: no PHP files staged — skipping."
  exit 0
fi

FAIL=0

for file in $STAGED; do
  php -l "$ROOT/$file" || FAIL=1
done

if [ "$FAIL" -ne 0 ]; then
  echo "❌ Pre-commit: PHP syntax check failed."
  exit 1
fi

cd "$ROOT" && vendor/bin/phpunit || exit 1

echo "✅ Pre-commit checks passed."
